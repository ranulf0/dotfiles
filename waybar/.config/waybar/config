{
  "layer": "top",
  "position": "top",
  "height": 28,

  "modules-left": ["mpris"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "custom/github",
    "cpu",
    "memory",
    "disk",
    "disk#home",
    "pulseaudio",
    "battery",
    "clock",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "tooltip": false
  },

  "cpu": {
    "format": "CPU {usage}%",
    "states": {
        "warning": 70,
        "critical": 90
    }
  },

  "memory": {
      "format": "RAM {percentage}%",
      "states": {
          "warning": 70,
          "critical": 90
      }
  },

  "disk": {
    "format": "{path} {percentage_free}%",
    "path": "/"
  },

  "disk#home": {
    "format": "/home {percentage_free}%",
    "path": "/home"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "muted",

    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "kitty --class wiremix -e wiremix",

    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "battery": {
    "format": "BAT {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

"clock": {
    "format": "{:%a %m/%d %I:%M %p}",
    "format-alt": "{:%A %y/%m/%d %I:%M:%S %p}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",

    "calendar": {
        "format": {
            "days": "<span color='#777777'>{}</span>",
            "today": "<span color='#ffffff'><b>{}</b></span>",
            //"months": "<span color='#ffffff'>{}</span>",
            //"weekdays": "<span color='#ffffff'>{}</span>",
        }
    }
},
  "tray": {
    "spacing": 10
  },

  "mpris": {
    "format": "<span size='120%' rise='-3000' color='#ffffff'>{player_icon}</span> <span color='#888888'>{artist}</span> - {title}",

    "player-icons": {
        "spotify": "",
        "spotatui": "",
        "spotifyd": "",
        "default": "󰎆"
    },

    "on-click": "playerctl play-pause",
    "interval": 1
  },

  "custom/github": {
    "exec": "~/.config/github/scripts/waybar.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "firefox github.com/notifications",
  },

}
